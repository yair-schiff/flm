    "x = to_numpy(curves[\"tau\"])\n",
    "\n",
    "for ax, (name, scale) in zip(axes, curve_specs):\n",
    "    y = to_numpy(curves[name])\n",
    "    ax.plot(x, y, lw=2.0, color=\"#111827\")\n",
    "    ax.set_title(f\"tau vs {name}\")\n",
    "    ax.set_xlabel(\"tau\")\n",
    "    ax.set_ylabel(name)\n",
    "    if scale == \"log\":\n",
    "        ax.set_yscale(\"log\")\n",
    "\n",
    "fig.suptitle(f\"{SCHEDULE_TYPE}: tau mappings\", fontsize=14)\n",
    "plt.show()"
   ]

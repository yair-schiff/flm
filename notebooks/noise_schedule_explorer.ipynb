   "source": [
    "tau_grid = torch.linspace(T_MIN, T_MAX, GRID_POINTS)\n",
    "curves = evaluate(schedule, tau_grid)\n",
    "\n",
    "curve_specs = [\n",
    "    (\"gamma\", \"linear\"),\n",
    "    (\"snr\", \"log\"),\n",
    "    (\"alpha\", \"linear\"),\n",
    "    (\"snr_prime\", \"log\"),\n",
